# Frontend environment variables for Vercel
# Add these in Vercel Project Settings > Environment Variables.
# Do not commit real secret values.

NEXT_PUBLIC_API_URL=https://apexathletics-apis.vercel.app/api

# Your deployed frontend URL, without a trailing slash.
# Example: https://apexathletics.vercel.app
NEXT_PUBLIC_SITE_URL=https://<your-frontend-domain>

# Must match the Stripe mode used by backend STRIPE_SECRET_KEY.
NEXT_PUBLIC_STRIPE_PUBLIC_KEY=pk_test_<your-stripe-publishable-key>
