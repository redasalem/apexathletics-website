# ==============================================================================
# APEX ATHLETICS — FRONTEND ENVIRONMENT VARIABLES (.env.example)
# Copy this file to .env.local and populate all values before starting the app.
# DO NOT COMMIT SECRETS TO VERSION CONTROL!
# ==============================================================================

# ── Site Configuration ────────────────────────────────────────────────────────
# Production: your Vercel deployment URL
NEXT_PUBLIC_SITE_URL=https://apexathletics.com

# ── API Configuration ─────────────────────────────────────────────────────────
# Development: point to your local backend
# Production: point to your deployed backend URL (Railway / Render / VPS)
NEXT_PUBLIC_API_URL=http://localhost:5000/api

# ── Stripe Configuration ──────────────────────────────────────────────────────
# Retrieve your publishable key from the Stripe Dashboard
NEXT_PUBLIC_STRIPE_PUBLIC_KEY=
